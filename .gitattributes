# Normalise text in Git and use LF on every platform, independent of core.autocrlf.
* text=auto eol=lf

# Windows command scripts require CRLF; PowerShell and shell scripts use LF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=lf
*.sh text eol=lf

*.md text diff
*.json text
*.toml text
*.txt text
*.yml text
*.lock text

# Media is never converted, and never committed: the tests generate their inputs with FFmpeg.
*.wav binary
*.mp3 binary
*.mp4 binary
*.opus binary
*.jpg binary
*.png binary
*.zip binary
